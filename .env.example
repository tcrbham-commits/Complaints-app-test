# Port the web server listens on
PORT=3000

# The CRM's inbound / email-to-case address that complaints are sent to
CRM_EMAIL=complaints@yourcrm.example.com
# Optional extra recipients, comma-separated (e.g. sales manager)
CC_EMAILS=

# Sender address (must be allowed by your SMTP provider)
FROM_EMAIL=complaints-app@yourcompany.com
SUBJECT_PREFIX=[Complaint]

# SMTP settings (Microsoft 365: smtp.office365.com / 587; Gmail: smtp.gmail.com / 587 with an app password)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=complaints-app@yourcompany.com
SMTP_PASS=change-me

# Optional shared code the sales team enters once per device. Leave blank to disable.
APP_ACCESS_CODE=

# Photo limits
MAX_FILES=5
MAX_FILE_SIZE_MB=8
